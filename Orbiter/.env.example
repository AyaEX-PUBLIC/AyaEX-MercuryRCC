ENV=dev
# the site's domain; host scripts come from http://www.DOMAIN unless SITE_URL is set
DOMAIN=localhost:8010
# where the Orbiter fetches places' host scripts from the site
SITE_URL=http://localhost:8010
IPV4=127.0.0.1
IPV6=::1
# the Site's GAMESERVER_KEY, sent when fetching a place's host script
GAMESERVER_KEY=password
# hosted gameservers run as native Aya.Server jobs, joined by browser Players
DEFAULT_ENGINE=aya
RCC_IS_AYA=1
# no Windows Studio to download from a Setup domain
SKIP_SETUP=1
# the RCC proxy (spawns and load balances Aya.Server instances)
PROXY_URL=http://localhost:64990
# proxy key for authenticating to the RCC proxy's host route (PROXY_KEY in Proxy/.env)
PROXY_KEY=password
