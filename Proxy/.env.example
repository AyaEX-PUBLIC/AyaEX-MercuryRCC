IP=::1
# the Site's render result route
ENDPOINT=http://localhost:8010/api/render/update
# the Site's RCC_KEY
RCC_KEY=password
# auth for the Orbiter's requests to /host and DELETE /host (empty = loopback/IP only);
# the same as PROXY_KEY in Orbiter/.env
PROXY_KEY=password
# render jobs per Aya.Server instance; hosted games get their own process
MAX_JOBS_PER_RCC=3
MAX_HOST_JOBS_PER_RCC=1
# the first instance binds this SOAP port, later instances use higher ports
RCC_BASE_PORT=64989
# hosting job expiration. Set to e.g. 300 for short-lived leases renewed via RenewLease
# (strategy 1), or to 0 for a practically permanent job that is closed explicitly with
# CloseJobEx (strategy 2)
HOST_EXPIRATION=300
# Orbiter's status route (statuses are relayed to POST {HOST_ENDPOINT}/{id})
HOST_ENDPOINT=http://localhost:64991
# native Aya.Server (from the AyaEX server archive) instead of RCCService.exe
# under Wine; an absolute path
RCC_EXE=/srv/ayaex/aya-dev/build/x64-linux-rel/bin/Aya.Server
# Aya.Server only reaches the Mercury site (and this proxy for its status pings);
# place scripts only the site. MercuryCore's aya/set-domain.sh swaps example.com
# for the site's public domain. Set --contentPath to the absolute path of
# aya-dev/client/resources/content, and --httpAccessKey to the Site's ASSET_KEY.
RCC_ARGS=--websocket --noconsole --insecure --baseUrl https://example.com/ --contentPath /srv/ayaex/aya-dev/client/resources/content --httpAllowHost localhost:8010 --httpAllowHost 127.0.0.1:8010 --httpAllowHost example.com:80 --httpAllowHost example.com:443 --httpAllowHost localhost:64990 --httpAllowHost 127.0.0.1:64990 --scriptHttpAllowHost localhost:8010 --scriptHttpAllowHost 127.0.0.1:8010 --scriptHttpAllowHost example.com:80 --scriptHttpAllowHost example.com:443 --httpAccessKey password
# Run hosted gameservers (native Aya.Server only) in a hardened container built
# on Docker Hardened Images: Gameserver/build.sh builds it under this name after
# `docker login dhi.io`. Each game gets a fresh container: unprivileged, no
# capabilities, read-only filesystem, host network. Renders stay native (they
# need DISPLAY). Leave empty to run gameservers as plain processes.
GAMESERVER_IMAGE=mercury-gameserver
# where gameservers keep DataStores (Aya.DataStore.sqlite3), relative to Proxy/
GAMESERVER_DATASTORE_DIR=../data/datastore
# per-gameserver limits
GAMESERVER_MEMORY=2g
GAMESERVER_CPUS=2
GAMESERVER_PIDS=512
